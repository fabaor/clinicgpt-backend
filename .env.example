# OpenAI (síntese de resumo clínico e conteúdo para pacientes)
OPENAI_API_KEY=

# Chave de assinatura dos tokens JWT — OBRIGATÓRIA em produção.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
# Sem essa variável, o servidor gera uma chave aleatória a cada início e
# invalida todos os tokens emitidos anteriormente a cada reinício.
SECRET_KEY=

# Caminho do banco SQLite com usuários/pacientes/atendimentos (opcional)
CLINICGPT_DB=clinicgpt.db

# NCBI/PubMed (opcional — sem chave funciona, com chave aumenta o limite de requisições)
NCBI_API_KEY=

# Busca web geral (opcional — sem chave, a fonte "web" é simplesmente ignorada)
TAVILY_API_KEY=

# Semantic Scholar (opcional — usado como fonte "evidencias")
SEMANTIC_SCHOLAR_API_KEY=

# Modelo usado para sintetizar o conteúdo (opcional)
CONTENT_AGENT_MODEL=gpt-3.5-turbo

# Caminho do banco SQLite do agente de conteúdo (opcional)
CONTENT_AGENT_DB=content_agent.db

# Liga/desliga a rotina diária automática (opcional, "true"/"false")
CONTENT_AGENT_SCHEDULER=true
